{
    // Debug della simulazione nel browser: avvia "npm run dev" e apre la
    // pagina locale. I breakpoint si mettono direttamente in
    // src/physics.js e src/app.js (grazie a dist/sandcastle.js.map).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "dev"
        },
        {
            "name": "Debug in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "dev"
        }
    ]
}
